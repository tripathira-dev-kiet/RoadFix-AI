# ===================================================================
# RoadFix AI - Environment Configuration Template (.env.example)
# Rename this file to .env and customize as needed.
# ===================================================================

PORT=8080

# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/roadfix_db?serverSelectionTimeoutMS=2500

# Cloud MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/roadfix_db?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000

DATABASE_NAME=roadfix_db
MAX_UPLOAD_SIZE=25MB
